[user]
	name = Robert Jackson
	email = <rjack2@gmail.com>
[color]
    ui = auto

[init]
    defaultBranch = main

[core]
    editor = vim

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = zdiff3

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD
    undo = reset --soft HEAD~1